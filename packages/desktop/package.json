{
  "name": "@docs-agent/desktop",
  "version": "4.0.2",
  "description": "DocForge 跨平台 Word 模板套版与 AI 排版桌面工作台",
  "author": "DocForge",
  "homepage": "https://github.com/GrassskyR/docx-forge",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "tsx scripts/bundle.ts",
    "dev": "npm run build && electron .",
    "pack": "electron-builder --dir -c electron-builder.yml",
    "dist": "electron-builder -c electron-builder.yml",
    "dist:linux": "electron-builder --linux -c electron-builder.yml",
    "dist:win": "electron-builder --win -c electron-builder.yml",
    "dist:mac": "electron-builder --mac -c electron-builder.yml"
  },
  "devDependencies": {
    "@docs-agent/engine": "*",
    "@docs-agent/server": "*",
    "@docs-agent/shared": "*",
    "electron": "45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0"
  }
}
