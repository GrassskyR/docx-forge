# OpenAI-compatible Chat Completions API. Never commit your real .env.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional token billing rates (USD per 1M tokens)
# LLM_INPUT_USD_PER_MILLION=0.27
# LLM_OUTPUT_USD_PER_MILLION=1.10

# Optional Langfuse Observability (OpenTelemetry SDK v4):
# Leave unset to automatically fall back to local pino structured logs (data/logs/server.log)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional Dual-Track Vision Audit Configuration (3 modes):
# Mode 1: Native multimodal main model -> LLM_SUPPORTS_VISION=true
# Mode 2: Cheap sidecar vision model -> set VISION_BASE_URL, VISION_API_KEY, VISION_MODEL
# Mode 3: Leave unset -> automatic graceful fallback to Poppler text telemetry + OOXML audit
# LLM_SUPPORTS_VISION=false
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL=

# Single-process unified HTTP/SSE/Web port (also compatible with ENGINE_PORT):
# PORT=8000
# LOG_LEVEL=info
# Benchmark & corpus test concurrency (defaults to min(12, cpu_cores - 2)):
# BENCH_CONCURRENCY=12
